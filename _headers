# Кеширование статических ресурсов на 1 год (31536000 секунд)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Кеширование JS файлов на 1 год
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Кеширование CSS файлов на 1 год
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Кеширование изображений на 1 год
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.jpg
  Cache-Control: public, max-age=31536000, immutable
/*.jpeg
  Cache-Control: public, max-age=31536000, immutable
/*.gif
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# Кеширование шрифтов на 1 год
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
/*.eot
  Cache-Control: public, max-age=31536000, immutable

# Не кешировать index.html для обновления при деплое
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

# Не кешировать корневой файл для обновления при деплое
/
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0 