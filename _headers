# Кеширование для статических ресурсов с хэшами (1 год)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Кеширование для JS файлов с хэшами (1 год)
/*.js
  Cache-Control: public, max-age=31536000, immutable

# Кеширование для CSS файлов с хэшами (1 год)
/*.css
  Cache-Control: public, max-age=31536000, immutable

# Кеширование для изображений и шрифтов (1 год)
/*.svg
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/*.woff2
  Cache-Control: public, max-age=31536000, immutable

# Не кешировать index.html для обновления ассетов
/index.html
  Cache-Control: no-cache, no-store, must-revalidate

# Не кешировать корневой файл для обновления
/
  Cache-Control: no-cache, no-store, must-revalidate 